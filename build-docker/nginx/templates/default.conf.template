server {
    listen       80 default_server;
    index index.html;
    root /web;

    # CORS
    # wildcard '*' is not allowed here
    more_set_headers 'Access-Control-Allow-Origin: $http_origin';
    more_set_headers 'Access-Control-Allow-Methods: GET, POST, OPTIONS, PUT, DELETE, HEAD, PATCH';
    more_set_headers 'Access-Control-Allow-Credentials: true';
    more_set_headers 'Access-Control-Max-Age: 86400';
    more_set_headers 'Access-Control-Expose-Headers: content-disposition';
    more_set_headers 'Access-Control-Allow-Headers: Accept, Accept-Encoding, Accept-Language, Connection, Content-Type, Host, Origin, Referer, Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site, User-Agent, sec-ch-ua, sec-ch-ua-mobile, sec-ch-ua-platform, Token, Authorization';
    more_set_headers Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; object-src 'none'";
    more_set_headers "X-Content-Type-Options: nosniff";
    if ($request_method = 'OPTIONS') {
        return 204;
    }

    location / {
        try_files $uri $uri/ /index.html;
        access_log off;
        break;
    }

    location ${MQTT_BROKER_WS_PATH} {
      proxy_pass http://${BEAVER_IOT_API_HOST}:${MQTT_BROKER_MOQUETTE_WEBSOCKET_PORT};
      proxy_ssl_server_name   on;
      proxy_http_version      1.1;
      proxy_set_header        Upgrade         $http_upgrade;
      proxy_set_header        Connection      "$connection_upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Port $remote_port;
      proxy_buffer_size 64k;
      proxy_buffers   32 32k;
      proxy_busy_buffers_size 128k;
      proxy_connect_timeout 5s;
      proxy_read_timeout 60s;
      proxy_send_timeout 30s;
      break;
    }

    location /public {
       proxy_pass http://${BEAVER_IOT_API_HOST}:${BEAVER_IOT_API_PORT};
       proxy_set_header Host $host;
       proxy_set_header X-Real-IP $remote_addr;
       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
       proxy_buffer_size 64k;
       proxy_buffers   32 32k;
       proxy_busy_buffers_size 128k;
       break;
    }

    location /api/v1/ {
       proxy_pass http://${BEAVER_IOT_API_HOST}:${BEAVER_IOT_API_PORT}/;
       proxy_set_header Host $host;
       proxy_set_header X-Real-IP $remote_addr;
       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
       proxy_buffer_size 64k;
       proxy_buffers   32 32k;
       proxy_busy_buffers_size 128k;
       break;
    }

    # Relay for an EdgeAI box's video pipeline streams, so a dashboard image widget can
    # show one. A browser <img> cannot send the Authorization/X-API-Key header the box
    # demands, and will not accept its self-signed certificate - neither is fixable from
    # the widget, both being browser rules. So the browser asks nginx for an ordinary
    # same-origin URL (/iriv-stream/<pipeline id>) and the awkward parts happen here, on
    # the LAN, where they are not the browser's business.
    #
    # Unauthenticated by design: nginx answers this before the API ever sees it, so
    # anyone who can reach Beaver IoT can view the stream. That matches the posture of a
    # LAN appliance already served over plain HTTP. Note an <img> could not send Beaver
    # IoT's own bearer token either, so restricting this would need a signed-URL or
    # cookie scheme rather than simply turning auth on.
    #
    # Only a numeric pipeline id matches, so this cannot be walked onto other paths of
    # the box's API.
    location ~ ^/iriv-stream/(\d+)$ {
       proxy_pass https://${EDGEAI_STREAM_HOST}/api/v1/pipelines/$1/stream?annotated=1;
       proxy_set_header X-API-Key "${EDGEAI_STREAM_API_KEY}";
       # The box presents a self-signed certificate. This is nginx's default, but it is
       # stated so it reads as a decision rather than an oversight.
       proxy_ssl_verify off;
       proxy_http_version 1.1;
       # Unlike every other block here, this one must NOT buffer. An MJPEG response
       # (multipart/x-mixed-replace) never ends, so buffering it means nginx accumulates
       # forever and the browser is shown nothing at all. The long timeouts are the same
       # story: the 60s used elsewhere would sever a live stream every minute.
       proxy_buffering off;
       proxy_read_timeout 24h;
       proxy_send_timeout 24h;
       break;
    }

}
